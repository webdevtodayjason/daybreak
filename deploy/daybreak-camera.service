[Unit]
Description=DAYBREAK rack camera MJPEG source (ustreamer :8812, loopback only)
Documentation=https://github.com/pikvm/ustreamer
After=network.target
# The camera may be unplugged or enumerate late; restart forever instead of
# hitting the default start-limit and staying dead for the rest of the week.
StartLimitIntervalSec=0

[Service]
Type=simple
User=daybreak
Group=daybreak
SupplementaryGroups=video
# --host 127.0.0.1 is load-bearing: only server.py may reach the camera,
# it is proxied to the browser through /cam.mjpg so nothing else is exposed.
# /dev/video0-3 are the CIX SoC codec engine, NOT the camera — the USB cam is
# video4; the by-id path survives node renumbering across reboots (bug: NO SIGNAL
# placeholder streams forever if this points at a non-capture node)
# sane sensor values: the UVC defaults drift to max gain/gamma = blown-out white
ExecStartPre=-/usr/bin/v4l2-ctl -d /dev/v4l/by-id/usb-InnoMaker_Innomaker-U20CAM-1080PD_N-S1_20010101-video-index0 --set-ctrl=brightness=0 --set-ctrl=contrast=38 --set-ctrl=gamma=300 --set-ctrl=gain=32 --set-ctrl=backlight_compensation=0 --set-ctrl=auto_exposure=3
ExecStart=/usr/bin/ustreamer -d /dev/v4l/by-id/usb-InnoMaker_Innomaker-U20CAM-1080PD_N-S1_20010101-video-index0 -m MJPEG -r 1280x720 -f 15 --host 127.0.0.1 -p 8812
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daybreak-camera
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
